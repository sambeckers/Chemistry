#!/bin/bash
# =============================================================================
# render_configs.slurm
#
# Embarrassingly parallel rendering — one array task per
# (CSV row × plane × xlim × xsec) combination.
#
# The flat task list is generated by submit_render_configs.sh and passed via
# the TASK_LIST environment variable.  Each task reads its own line:
#   row_idx,plane,xlim,xsec
# and calls render_slice_v2.py with those specific overrides.
#
# Typical submission (via the bash wrapper — recommended):
#   bash submit_render_configs.sh 1581
#
# Or manually (after generating task_list manually):
#   sbatch --array=0-N \
#          --export=ALL,DUMP_INDEX=1581,TASK_LIST=/path/to/task_list_1581.txt \
#          render_configs.slurm
# =============================================================================

#SBATCH --job-name=render_cfg
#SBATCH --output=logs_%A/render_%A_%a.out
#SBATCH --error=logs_%A/render_%A_%a.err
#SBATCH --array=0-14           # overridden by submit_render_configs.sh
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2      # sarracen can use threads; raise if needed
#SBATCH --mem-per-cpu=8G       # SPH rendering is memory-hungry
#SBATCH --time=01:00:00        # adjust based on dump size / mode

# ---------------------------------------------------------------------------
# Environment variables (set via --export from submit_render_configs.sh)
# ---------------------------------------------------------------------------
DUMP_INDEX=${DUMP_INDEX:-}          # e.g. 1581  (mutually exclusive with DUMP)
DUMP=${DUMP:-}                      # full path to a specific dump .h5 file
CHEMISTRY=${CHEMISTRY:-Crich}       # Crich | Orich
CMAP=${CMAP:-gist_heat}
TASK_LIST=${TASK_LIST:-}            # path to task_list_<DUMP_INDEX>.txt

SCRIPT_DIR="/fred/oz304/beckers/Chemistry/pipeline/plotting"
CONFIG_CSV="${SCRIPT_DIR}/configs_render.csv"

# ---------------------------------------------------------------------------
# Read this task's (row, plane, xlim, xsec) from the task list
# sed line numbers are 1-based; SLURM_ARRAY_TASK_ID is 0-based
# ---------------------------------------------------------------------------
if [ -z "${TASK_LIST}" ] || [ ! -f "${TASK_LIST}" ]; then
    echo "ERROR: TASK_LIST is not set or file does not exist: '${TASK_LIST}'" >&2
    echo "       Run submit_render_configs.sh to generate it automatically." >&2
    exit 1
fi

LINE=$(sed -n "$(( SLURM_ARRAY_TASK_ID + 1 ))p" "${TASK_LIST}")
if [ -z "${LINE}" ]; then
    echo "ERROR: no line $(( SLURM_ARRAY_TASK_ID + 1 )) in ${TASK_LIST}" >&2
    exit 1
fi

ROW_IDX=$(echo "${LINE}" | cut -d, -f1)
PLANE=$(   echo "${LINE}" | cut -d, -f2)
XLIM=$(    echo "${LINE}" | cut -d, -f3)
XSEC=$(    echo "${LINE}" | cut -d, -f4)

echo "======================================================="
echo "  Array task   : ${SLURM_ARRAY_TASK_ID} / ${SLURM_ARRAY_TASK_MAX}"
echo "  CSV row       : ${ROW_IDX}"
echo "  Plane         : ${PLANE}"
echo "  Xlim          : ${XLIM}"
echo "  Xsec          : ${XSEC}"
echo "  Chemistry     : ${CHEMISTRY}"
echo "  DUMP_INDEX    : ${DUMP_INDEX:-<not set>}"
echo "  DUMP          : ${DUMP:-<not set>}"
echo "======================================================="

# Create log directory
mkdir -p "logs_${SLURM_ARRAY_JOB_ID}"

# ---------------------------------------------------------------------------
# Activate conda environment
# ---------------------------------------------------------------------------
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate /fred/oz304/beckers/KB

# ---------------------------------------------------------------------------
# Build dump argument
# ---------------------------------------------------------------------------
DUMP_ARG=""
if [ -n "${DUMP}" ]; then
    DUMP_ARG="--dump ${DUMP}"
elif [ -n "${DUMP_INDEX}" ]; then
    DUMP_ARG="--dump-index ${DUMP_INDEX}"
else
    echo "ERROR: set DUMP_INDEX or DUMP via --export" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Run — pass the CSV row plus the single (plane, xlim, xsec) for this task
# ---------------------------------------------------------------------------
python "${SCRIPT_DIR}/render_slice_v2.py" \
    ${DUMP_ARG}                              \
    --config-csv   "${CONFIG_CSV}"           \
    --config-row   "${ROW_IDX}"              \
    --config-plane "${PLANE}"                \
    --config-xlim  "${XLIM}"                 \
    --config-xsec  "${XSEC}"                 \
    --chemistry    "${CHEMISTRY}"            \
    --cmap         "${CMAP}"
