FIC           = 0.5:0.45:0.44:0.43:0.42:0.41:0.4
FVOL          = 0.5
L             = 2e13
SPECIES_FILE             = rate16_IP_6000K_CWLeo_Agundez2012_Htot_C2H2_2e-5_HCN_5e-6.specs




