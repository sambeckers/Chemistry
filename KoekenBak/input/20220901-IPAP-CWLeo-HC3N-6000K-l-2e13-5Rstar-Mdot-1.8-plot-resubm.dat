###########################
### INPUT FOR COMBOCODE ###
###########################
###################
# GENERAL INPUT
###################
#-- Which codes to run
CHEMISTRY=1                         	# Perform Forward Chemistry modelling
SINGLE_SESSION = 0

#-- Output folder management

PATH_CHEMISTRY = src-CWLeo

SRC_CHEMISTRY        = src-CWLeo

#-- Various settings for this CC session
REPLACE_DB_ENTRY=0                  	# Be very careful with putting this keyword to 1! If a model in a database is found (usually cooling or mcmax), it is replaced by a newly calculated model (also with a new model_id). Any mline, sphinx or pacs models stemming from the same cooling id will also be deleted!!!! Now works with grids as well: Any new calculated model in the grid will NOT be deleted. (hence, if an MCMax model is the same for all models in the grid, it will not be calculated anew every single time)

####################
# Stellar parameters
####################
STAR_NAME                       = cwleo      # Stellar Name (lower cases, no spaces, only SIMBAD name is accepted, greek letters written in full, omicron = o)



#-- GRAIN PARAMETERS FOR H2 FORMATION AND CR IONISATION
A_G = 1.0E-5
X_G = 1.5e-12
ALBEDO = 0.5
ZETA = 1
GAMCO = 3
AUV_AV = 4.65


#-- GAS TEMPERATURE
TEMPMODE = EPSILON
EPSILON_TEMP_LAW = 0.55
T_STAR = 2330.0

R_STAR = 4e13
R_EPSIL = 4e13


#-- DENSITY

MLOSS = 1.8e-5
VELOCITY = 14.5e5



#-- RADIUS INFORMATION
R_INNER_CHEM            = 2.05e14
R_OUTER_CHEM            = 1e18
RESOLUTION              = 0.03




! INNER PHOTONS


RSCALE = 50
RDUST = 5.0

TBIN = 6000
RBIN = 8.14e10


#-- CLUMPING PARAMETERS

ISTELLAR  = 1
IBIN      = 2


CLUMPMODE     = POROSITY

FIC           = 0.5
FVOL          = 0.5
L             = 2e13;4e13


